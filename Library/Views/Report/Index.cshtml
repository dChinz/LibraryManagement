@{
    ViewData["Title"] = "Báo cáo";
    var totalBooks = ViewBag.TotalBooks ?? 0;
    var availableBooks = ViewBag.AvailableBooks ?? 0;
    var borrowingBooks = ViewBag.BorrowingBooks ?? 0;
    var returnedBooks = ViewBag.ReturnedBooks ?? 0;
    var totalMembers = ViewBag.TotalMembers ?? 0;
    var activeMembers = ViewBag.ActiveMembers ?? 0;
    var expiryMembers = ViewBag.ExpiryMembers ?? 0;
    var overdueBooks = ViewBag.OverdueBooks ?? 0;
    var totalFines = ViewBag.TotalFines ?? 0;
    var paidFines = ViewBag.PaidFines ?? 0;
    var unpaidFines = ViewBag.UnpaidFines ?? 0;
    var monthlyBorrows = ViewBag.MonthlyBorrows ?? 0;
    var monthlyReturns = ViewBag.MonthlyReturns ?? 0;
    var categories = ViewBag.Categories ?? 0;
}
<div class="container-fluid report-page">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Báo cáo thư viện</h1>
            <p class="text-muted mb-0">
                Thống kê và tổng quan hoạt động của thư viện
            </p>
        </div>
        <button type="button"
                class="btn btn-outline-secondary"
                onclick="window.print()">
            <i class="bi bi-printer me-1"></i>
            In báo cáo
        </button>
    </div>
    <!-- ============================== -->
    <!-- BIỂU ĐỒ -->
    <!-- ============================== -->
    <div class="row g-3 mb-4">
        <!-- BIỂU ĐỒ TÌNH TRẠNG SÁCH -->
        <div class="col-xl-4">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tình trạng sách
                        </h5>
                        <span class="text-muted small">
                            Phân bố số lượng sách hiện tại
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-pie-chart"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-doughnut">
                        <canvas id="bookStatusChart"></canvas>
                    </div>
                    <div class="chart-legend mt-3">
                        <div class="legend-item">
                            <span class="legend-dot bg-success"></span>
                            <span>
                                Có sẵn
                            </span>
                            <strong>
                                @availableBooks.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-warning"></span>
                            <span>
                                Đang mượn
                            </span>
                            <strong>
                                @borrowingBooks.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-danger"></span>
                            <span>
                                Quá hạn
                            </span>
                            <strong>
                                @overdueBooks.ToString("N0")
                            </strong>
                        </div>
                    </div>
                    <a asp-controller="Book"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100 mt-3">
                        <i class="bi bi-eye me-1"></i>
                        Quản lý sách
                    </a>
                </div>
            </div>
        </div>
        <!-- BIỂU ĐỒ ĐỘC GIẢ -->
        <div class="col-xl-4">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tình trạng độc giả
                        </h5>
                        <span class="text-muted small">
                            Trạng thái hoạt động
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-people"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-doughnut">
                        <canvas id="memberStatusChart"></canvas>
                    </div>
                    <div class="chart-legend mt-3">
                        <div class="legend-item">
                            <span class="legend-dot bg-success"></span>
                            <span>
                                Đang hoạt động
                            </span>
                            <strong>
                                @activeMembers.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-success"></span>
                            <span>
                                Hết hạn
                            </span>
                            <strong>
                                @expiryMembers.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-secondary"></span>
                            <span>
                                Khác
                            </span>
                            <strong>
                                @(totalMembers - activeMembers - expiryMembers  < 0? 0 : totalMembers - activeMembers - expiryMembers)
                            </strong>
                        </div>
                    </div>
                    <a asp-controller="Member"
                       asp-action="Index"
                       class="btn btn-outline-success w-100 mt-3">
                        <i class="bi bi-eye me-1"></i>
                        Quản lý độc giả
                    </a>
                </div>
            </div>
        </div>
        <!-- TIỀN PHẠT -->
        <div class="col-xl-4">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tiền phạt
                        </h5>
                        <span class="text-muted small">
                            Tình hình xử lý tiền phạt
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-cash-coin"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-fine">
                        <canvas id="fineChart"></canvas>
                    </div>
                    <div class="fine-summary mt-3">
                        <div>
                            <span class="text-muted small">
                                Tổng tiền phạt
                            </span>
                            <strong>
                                @string.Format("{0:N0} ₫", totalFines)
                            </strong>
                        </div>
                        <div>
                            <span class="text-muted small">
                                Đã thanh toán
                            </span>
                            <strong class="text-success">
                                @string.Format("{0:N0} ₫", paidFines)
                            </strong>
                        </div>
                        <div>
                            <span class="text-muted small">
                                Chưa thanh toán
                            </span>
                            <strong class="text-danger">
                                @string.Format("{0:N0} ₫", unpaidFines)
                            </strong>
                        </div>
                    </div>
                    <a asp-controller="Fine"
                       asp-action="Index"
                       class="btn btn-outline-warning w-100 mt-3">
                        <i class="bi bi-eye me-1"></i>
                        Quản lý tiền phạt
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================== -->
    <!-- MƯỢN / TRẢ -->
    <!-- ============================== -->
    <div class="row g-3 mb-4">
        <div class="col-xl-12">
            <div class="card report-card">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Hoạt động mượn và trả
                        </h5>
                        <span class="text-muted small">
                            Thống kê trong tháng hiện tại
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-bar-chart"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-bar">
                        <canvas id="borrowReturnChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================== -->
    <!-- CHI TIẾT THỐNG KÊ -->
    <!-- ============================== -->
    <div class="card report-card mb-4">
        <div class="card-header">
            <div>
                <h5 class="mb-1 fw-semibold">
                    Chi tiết thống kê
                </h5>
                <span class="text-muted small">
                    Các chỉ số chính của thư viện
                </span>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-primary">
                            <i class="bi bi-book"></i>
                        </div>
                        <div class="text-muted small">
                            Tổng số đầu sách
                        </div>
                        <div class="fs-4 fw-bold">
                            @totalBooks.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="text-muted small">
                            Sách có sẵn
                        </div>
                        <div class="fs-4 fw-bold">
                            @availableBooks.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-warning">
                            <i class="bi bi-journal-arrow-up"></i>
                        </div>
                        <div class="text-muted small">
                            Lượt mượn tháng này
                        </div>
                        <div class="fs-4 fw-bold">
                            @monthlyBorrows.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-info">
                            <i class="bi bi-journal-check"></i>
                        </div>
                        <div class="text-muted small">
                            Lượt trả tháng này
                        </div>
                        <div class="fs-4 fw-bold">
                            @monthlyReturns.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ============================== -->
<!-- CHART.JS -->
<!-- ============================== -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        /* =========================
           TÌNH TRẠNG SÁCH
        ========================= */
        const bookChart = document.getElementById("bookStatusChart");
        if (bookChart) {
            new Chart(bookChart, {
                type: "doughnut",
                data: {
                    labels: [
                        "Có sẵn",
                        "Đang mượn",
                        "Quá hạn"
                    ],
                    datasets: [{
                        data: [
                            @availableBooks,
                            @borrowingBooks,
                            @overdueBooks
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
        /* =========================
           TÌNH TRẠNG ĐỘC GIẢ
        ========================= */
        const memberChart =
            document.getElementById("memberStatusChart");
        if (memberChart) {
            const otherMembers =
                Math.max(
                    0,
                    @totalMembers - @activeMembers
                );
            new Chart(memberChart, {
                type: "doughnut",
                data: {
                    labels: [
                        "Đang hoạt động",
                        "Khác"
                    ],
                    datasets: [{
                        data: [
                            @activeMembers,
                            otherMembers
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
        /* =========================
           MƯỢN / TRẢ
        ========================= */
        const borrowReturnChart =
            document.getElementById("borrowReturnChart");
        if (borrowReturnChart) {
            new Chart(borrowReturnChart, {
                type: "bar",
                data: {
                    labels: [
                        "Lượt mượn",
                        "Lượt trả"
                    ],
                    datasets: [{
                        label: "Số lượt",
                        data: [
                            @monthlyBorrows,
                            @monthlyReturns
                        ],
                        borderWidth: 1,
                        borderRadius: 6,
                        barThickness: 70
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }
        /* =========================
           TIỀN PHẠT
        ========================= */
        const fineChart =
            document.getElementById("fineChart");
        if (fineChart) {
            new Chart(fineChart, {
                type: "doughnut",
                data: {
                    labels: [
                        "Đã thanh toán",
                        "Chưa thanh toán"
                    ],
                    datasets: [{
                        data: [
                            @paidFines,
                            @unpaidFines
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        }
    });
</script>