@{
    ViewData["Title"] = "Báo cáo";
    var totalBooks = ViewBag.TotalBooks ?? 0;
    var availableBooks = ViewBag.AvailableBooks ?? 0;
    var borrowingBooks = ViewBag.BorrowingBooks ?? 0;
    var returnedBooks = ViewBag.ReturnedBooks ?? 0;
    var totalMembers = ViewBag.TotalMembers ?? 0;
    var activeMembers = ViewBag.ActiveMembers ?? 0;
    var overdueBooks = ViewBag.OverdueBooks ?? 0;
    var totalFines = ViewBag.TotalFines ?? 0;
    var paidFines = ViewBag.PaidFines ?? 0;
    var unpaidFines = ViewBag.UnpaidFines ?? 0;
    var monthlyBorrows = ViewBag.MonthlyBorrows ?? 0;
    var monthlyReturns = ViewBag.MonthlyReturns ?? 0;
    var categories = ViewBag.Categories ?? 0;
}
<div class="container-fluid report-page">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1 fw-semibold">
                Báo cáo thư viện
            </h1>
            <p class="text-muted mb-0">
                Thống kê và tổng quan hoạt động của thư viện
            </p>
        </div>
        <button type="button"
                class="btn btn-outline-secondary"
                onclick="window.print()">
            <i class="bi bi-printer me-1"></i>
            In báo cáo
        </button>
    </div>
    <!-- ============================== -->
    <!-- THỐNG KÊ TỔNG QUAN -->
    <!-- ============================== -->
    <div class="row g-3 mb-4">
        <!-- Tổng sách -->
        <div class="col-xl-3 col-md-6">
            <div class="report-stat-card">
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-book"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">
                        Tổng số sách
                    </div>
                    <div class="stat-value">
                        @totalBooks.ToString("N0")
                    </div>
                    <a asp-controller="Book"
                       asp-action="Index"
                       class="stat-link">
                        Xem danh sách
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Độc giả -->
        <div class="col-xl-3 col-md-6">
            <div class="report-stat-card">
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">
                        Tổng số độc giả
                    </div>
                    <div class="stat-value">
                        @totalMembers.ToString("N0")
                    </div>
                    <a asp-controller="Member"
                       asp-action="Index"
                       class="stat-link">
                        Xem danh sách
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Đang mượn -->
        <div class="col-xl-3 col-md-6">
            <div class="report-stat-card">
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-journal-arrow-up"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">
                        Sách đang được mượn
                    </div>
                    <div class="stat-value">
                        @borrowingBooks.ToString("N0")
                    </div>
                    <a asp-controller="BorrowRecord"
                       asp-action="Index"
                       class="stat-link">
                        Xem lượt mượn
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Quá hạn -->
        <div class="col-xl-3 col-md-6">
            <div class="report-stat-card">
                <div class="stat-icon bg-danger-subtle text-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-label">
                        Sách quá hạn
                    </div>
                    <div class="stat-value">
                        @overdueBooks.ToString("N0")
                    </div>
                    <a asp-controller="BorrowRecord"
                       asp-action="Index"
                       class="stat-link text-danger">
                        Xem chi tiết
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================== -->
    <!-- BIỂU ĐỒ -->
    <!-- ============================== -->
    <div class="row g-3 mb-4">
        <!-- BIỂU ĐỒ TÌNH TRẠNG SÁCH -->
        <div class="col-xl-5">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tình trạng sách
                        </h5>
                        <span class="text-muted small">
                            Phân bố số lượng sách hiện tại
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-pie-chart"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-doughnut">
                        <canvas id="bookStatusChart"></canvas>
                    </div>
                    <div class="chart-legend mt-3">
                        <div class="legend-item">
                            <span class="legend-dot bg-success"></span>
                            <span>
                                Có sẵn
                            </span>
                            <strong>
                                @availableBooks.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-warning"></span>
                            <span>
                                Đang mượn
                            </span>
                            <strong>
                                @borrowingBooks.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-danger"></span>
                            <span>
                                Quá hạn
                            </span>
                            <strong>
                                @overdueBooks.ToString("N0")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- BIỂU ĐỒ ĐỘC GIẢ -->
        <div class="col-xl-4">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tình trạng độc giả
                        </h5>
                        <span class="text-muted small">
                            Trạng thái hoạt động
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-people"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-doughnut">
                        <canvas id="memberStatusChart"></canvas>
                    </div>
                    <div class="text-center mt-2">
                        <div class="text-muted small">
                            Tổng số độc giả
                        </div>
                        <div class="fs-3 fw-bold">
                            @totalMembers.ToString("N0")
                        </div>
                    </div>
                    <div class="chart-legend mt-3">
                        <div class="legend-item">
                            <span class="legend-dot bg-success"></span>
                            <span>
                                Đang hoạt động
                            </span>
                            <strong>
                                @activeMembers.ToString("N0")
                            </strong>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot bg-secondary"></span>
                            <span>
                                Khác
                            </span>
                            <strong>
                                @(totalMembers - activeMembers < 0
                                    ? 0
                                    : totalMembers - activeMembers)
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- THỐNG KÊ NHANH -->
        <div class="col-xl-3">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tổng quan
                        </h5>
                        <span class="text-muted small">
                            Thông tin thư viện
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-info-circle"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="overview-item">
                        <div class="overview-icon bg-primary-subtle text-primary">
                            <i class="bi bi-book"></i>
                        </div>
                        <div>
                            <div class="text-muted small">
                                Tổng số sách
                            </div>
                            <strong>
                                @totalBooks.ToString("N0")
                            </strong>
                        </div>
                    </div>
                    <div class="overview-item">
                        <div class="overview-icon bg-success-subtle text-success">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <div class="text-muted small">
                                Độc giả
                            </div>
                            <strong>
                                @totalMembers.ToString("N0")
                            </strong>
                        </div>
                    </div>
                    <div class="overview-item">
                        <div class="overview-icon bg-info-subtle text-info">
                            <i class="bi bi-tags"></i>
                        </div>
                        <div>
                            <div class="text-muted small">
                                Thể loại sách
                            </div>
                            <strong>
                                @categories.ToString("N0")
                            </strong>
                        </div>
                    </div>
                    <div class="overview-item">
                        <div class="overview-icon bg-danger-subtle text-danger">
                            <i class="bi bi-exclamation-circle"></i>
                        </div>
                        <div>
                            <div class="text-muted small">
                                Sách quá hạn
                            </div>
                            <strong class="text-danger">
                                @overdueBooks.ToString("N0")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================== -->
    <!-- MƯỢN / TRẢ -->
    <!-- ============================== -->
    <div class="row g-3 mb-4">
        <div class="col-xl-8">
            <div class="card report-card">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Hoạt động mượn và trả
                        </h5>
                        <span class="text-muted small">
                            Thống kê trong tháng hiện tại
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-bar-chart"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-bar">
                        <canvas id="borrowReturnChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- TIỀN PHẠT -->
        <div class="col-xl-4">
            <div class="card report-card h-100">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1 fw-semibold">
                            Tiền phạt
                        </h5>
                        <span class="text-muted small">
                            Tình hình xử lý tiền phạt
                        </span>
                    </div>
                    <span class="report-header-icon">
                        <i class="bi bi-cash-coin"></i>
                    </span>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper chart-fine">
                        <canvas id="fineChart"></canvas>
                    </div>
                    <div class="fine-summary mt-3">
                        <div>
                            <span class="text-muted small">
                                Tổng tiền phạt
                            </span>
                            <strong>
                                @string.Format("{0:N0} ₫", totalFines)
                            </strong>
                        </div>
                        <div>
                            <span class="text-muted small">
                                Đã thanh toán
                            </span>
                            <strong class="text-success">
                                @string.Format("{0:N0} ₫", paidFines)
                            </strong>
                        </div>
                        <div>
                            <span class="text-muted small">
                                Chưa thanh toán
                            </span>
                            <strong class="text-danger">
                                @string.Format("{0:N0} ₫", unpaidFines)
                            </strong>
                        </div>
                    </div>
                    <a asp-controller="Fine"
                       asp-action="Index"
                       class="btn btn-outline-primary w-100 mt-3">
                        <i class="bi bi-eye me-1"></i>
                        Quản lý tiền phạt
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================== -->
    <!-- CHI TIẾT THỐNG KÊ -->
    <!-- ============================== -->
    <div class="card report-card mb-4">
        <div class="card-header">
            <div>
                <h5 class="mb-1 fw-semibold">
                    Chi tiết thống kê
                </h5>
                <span class="text-muted small">
                    Các chỉ số chính của thư viện
                </span>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-primary">
                            <i class="bi bi-book"></i>
                        </div>
                        <div class="text-muted small">
                            Tổng số đầu sách
                        </div>
                        <div class="fs-4 fw-bold">
                            @totalBooks.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="text-muted small">
                            Sách có sẵn
                        </div>
                        <div class="fs-4 fw-bold">
                            @availableBooks.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-warning">
                            <i class="bi bi-journal-arrow-up"></i>
                        </div>
                        <div class="text-muted small">
                            Lượt mượn tháng này
                        </div>
                        <div class="fs-4 fw-bold">
                            @monthlyBorrows.ToString("N0")
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="detail-stat">
                        <div class="detail-icon text-info">
                            <i class="bi bi-journal-check"></i>
                        </div>
                        <div class="text-muted small">
                            Lượt trả tháng này
                        </div>
                        <div class="fs-4 fw-bold">
                            @monthlyReturns.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ============================== -->
<!-- CHART.JS -->
<!-- ============================== -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        /* =========================
           TÌNH TRẠNG SÁCH
        ========================= */
        const bookChart = document.getElementById("bookStatusChart");
        if (bookChart) {
            new Chart(bookChart, {
                type: "doughnut",
                data: {
                    labels: [
                        "Có sẵn",
                        "Đang mượn",
                        "Quá hạn"
                    ],
                    datasets: [{
                        data: [
                            @availableBooks,
                            @borrowingBooks,
                            @overdueBooks
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
        /* =========================
           TÌNH TRẠNG ĐỘC GIẢ
        ========================= */
        const memberChart =
            document.getElementById("memberStatusChart");
        if (memberChart) {
            const otherMembers =
                Math.max(
                    0,
                    @totalMembers - @activeMembers
                );
            new Chart(memberChart, {
                type: "doughnut",
                data: {
                    labels: [
                        "Đang hoạt động",
                        "Khác"
                    ],
                    datasets: [{
                        data: [
                            @activeMembers,
                            otherMembers
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
        /* =========================
           MƯỢN / TRẢ
        ========================= */
        const borrowReturnChart =
            document.getElementById("borrowReturnChart");
        if (borrowReturnChart) {
            new Chart(borrowReturnChart, {
                type: "bar",
                data: {
                    labels: [
                        "Lượt mượn",
                        "Lượt trả"
                    ],
                    datasets: [{
                        label: "Số lượt",
                        data: [
                            @monthlyBorrows,
                            @monthlyReturns
                        ],
                        borderWidth: 1,
                        borderRadius: 6,
                        barThickness: 70
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }
        /* =========================
           TIỀN PHẠT
        ========================= */
        const fineChart =
            document.getElementById("fineChart");
        if (fineChart) {
            new Chart(fineChart, {
                type: "doughnut",
                data: {
                    labels: [
                        "Đã thanh toán",
                        "Chưa thanh toán"
                    ],
                    datasets: [{
                        data: [
                            @paidFines,
                            @unpaidFines
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "65%",
                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        }
    });
</script>
<!-- ============================== -->
<!-- CSS -->
<!-- ============================== -->
<style>
    /* =========================================================
       REPORT - DARK DASHBOARD THEME
       ========================================================= */
    .report-page {
        padding-bottom: 30px;
        color: #f5f5f5;
    }
    /* =========================================================
       PAGE HEADER
       ========================================================= */
    .report-page h1 {
        color: #f5f5f5;
    }
    .report-page .text-muted {
        color: #adb5bd !important;
    }
    .report-page .btn-outline-secondary {
        color: #adb5bd;
        border-color: #555b61;
        background: transparent;
    }
    .report-page .btn-outline-secondary:hover {
        color: #fff;
        background: #343a40;
        border-color: #6c757d;
    }
    /* =========================================================
       STAT CARD
       ========================================================= */
    .report-stat-card {
        background: #212529;
        border: 1px solid #3d4349;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        height: 100%;
        transition: all .2s ease;
    }
    .report-stat-card:hover {
        transform: translateY(-2px);
        border-color: #555b61;
        box-shadow: 0 5px 20px rgba(0, 0, 0, .25);
    }
    .stat-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }
    .stat-content {
        min-width: 0;
    }
    .stat-label {
        color: #adb5bd;
        font-size: 14px;
        margin-bottom: 3px;
    }
    .stat-value {
        color: #f5f5f5;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 5px;
    }
    .stat-link {
        color: #0d6efd;
        font-size: 13px;
        text-decoration: none;
    }
    .stat-link:hover {
        color: #6ea8fe;
    }
    .stat-link.text-danger {
        color: #ea868f !important;
    }
    .stat-link.text-danger:hover {
        color: #f1aeb5 !important;
    }
    /* =========================================================
       BOOTSTRAP SUBTLE COLORS
       ========================================================= */
    .report-page .bg-primary-subtle {
        background-color: rgba(13, 110, 253, .18) !important;
    }
    .report-page .bg-success-subtle {
        background-color: rgba(25, 135, 84, .18) !important;
    }
    .report-page .bg-warning-subtle {
        background-color: rgba(255, 193, 7, .18) !important;
    }
    .report-page .bg-danger-subtle {
        background-color: rgba(220, 53, 69, .18) !important;
    }
    .report-page .bg-info-subtle {
        background-color: rgba(13, 202, 240, .18) !important;
    }
    .report-page .text-primary {
        color: #6ea8fe !important;
    }
    .report-page .text-success {
        color: #75b798 !important;
    }
    .report-page .text-warning {
        color: #ffda6a !important;
    }
    .report-page .text-danger {
        color: #ea868f !important;
    }
    .report-page .text-info {
        color: #6edff6 !important;
    }
    /* =========================================================
       CARD
       ========================================================= */
    .report-card {
        background: #212529;
        border: 1px solid #3d4349;
        border-radius: 6px;
        box-shadow: none;
        overflow: hidden;
    }
    .report-card .card-header {
        background: #212529;
        color: #f5f5f5;
        border-bottom: 1px solid #3d4349;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .report-card .card-header h5 {
        color: #f5f5f5;
        font-weight: 500;
    }
    .report-card .card-header .small {
        color: #adb5bd !important;
    }
    .report-card .card-body {
        background: #212529;
        color: #f5f5f5;
        padding: 20px;
    }
    .report-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 7px;
        background: #292e33;
        border: 1px solid #3d4349;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
    }
    /* =========================================================
       CHART
       ========================================================= */
    .chart-wrapper {
        position: relative;
        width: 100%;
    }
    .chart-doughnut {
        height: 230px;
    }
    .chart-bar {
        height: 300px;
    }
    .chart-fine {
        height: 220px;
    }
    /* =========================================================
       LEGEND
       ========================================================= */
    .chart-legend {
        border-top: 1px solid #3d4349;
        padding-top: 12px;
    }
    .legend-item {
        color: #ced4da;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 0;
        font-size: 14px;
    }
    .legend-item strong {
        color: #f5f5f5;
        margin-left: auto;
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .legend-dot.bg-success {
        background-color: #198754 !important;
    }
    .legend-dot.bg-warning {
        background-color: #ffc107 !important;
    }
    .legend-dot.bg-danger {
        background-color: #dc3545 !important;
    }
    .legend-dot.bg-secondary {
        background-color: #6c757d !important;
    }
    /* =========================================================
       OVERVIEW
       ========================================================= */
    .overview-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #3d4349;
    }
    .overview-item:last-child {
        border-bottom: 0;
