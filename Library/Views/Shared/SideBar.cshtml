<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
    <div class="sidebar-brand">
        <a asp-controller="Home" asp-action="Index" class="brand-link">
            <span class="brand-text fw-light">
                📚 Library Management
            </span>
        </a>
    </div>

    <div class="sidebar-wrapper">
        <nav class="mt-2" aria-label="Main navigation">
            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                data-accordion="false"
                id="navigation">

                <!-- DASHBOARD -->
                <li class="nav-item">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-speedometer2"></i>
                        <p>@Localizer["DashboardTitle"]</p>
                    </a>
                </li>

                <!-- BOOKS -->
                <li class="nav-item">
                    <a asp-controller="Book"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-book"></i>
                        <p>@Localizer["BookManagement"]</p>
                    </a>
                </li>

                <!-- MEMBERS -->
                <li class="nav-item">
                    <a asp-controller="Member"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-people"></i>
                        <p>@Localizer["MemberManagement"]</p>
                    </a>
                </li>

                <!-- BORROW / RETURN -->
                <li class="nav-item">
                    <a asp-controller="BorrowRecord"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-arrow-left-right"></i>
                        <p>@Localizer["BorrowManagement"]</p>
                    </a>
                </li>

                <!-- CATEGORY -->
                <li class="nav-item">
                    <a asp-controller="Category"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-tags"></i>
                        <p>@Localizer["CategoryManagement"]</p>
                    </a>
                </li>

                <!-- FINES -->
                <li class="nav-item">
                    <a asp-controller="Fine"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-cash-coin"></i>
                        <p>@Localizer["FineManagement"]</p>
                    </a>
                </li>

                <!-- REPORTS -->
                <li class="nav-item">
                    <a asp-controller="Report"
                       asp-action="Index"
                       class="nav-link">
                        <i class="nav-icon bi bi-bar-chart"></i>
                        <p>@Localizer["Reports"]</p>
                    </a>
                </li>

                <!-- USER MANAGEMENT: ADMIN ONLY -->
                @if (User.IsInRole("ADMIN"))
                {
                    <li class="nav-item">
                        <a asp-controller="User"
                           asp-action="Index"
                           class="nav-link">
                            <i class="nav-icon bi bi-person-gear"></i>
                            <p>@Localizer["UserManagement"]</p>
                        </a>
                    </li>
                }

            </ul>
        </nav>
    </div>
</aside>