@using Microsoft.AspNetCore.WebUtilities
@model Library.Models.PaginationViewModel

@{
    string GetPageUrl(int page)
    {
        var routeValues = new Dictionary<string, string?>();

        foreach (var item in Model.RouteValues)
        {
            routeValues[item.Key] = item.Value;
        }

        routeValues[Model.PageParameter] = page.ToString();
        routeValues["pageSize"] = Model.PageSize.ToString();

        return QueryHelpers.AddQueryString("", routeValues);
    }
}

@if (Model.TotalPages >= 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center mt-2">

            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link"
                   href="@GetPageUrl(Model.CurrentPage - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       href="@GetPageUrl(i)">
                    @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link"
                   href="@GetPageUrl(Model.CurrentPage + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
}