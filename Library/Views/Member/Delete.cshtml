@model Library.Models.Member

@{
    ViewData["Title"] = "Xóa độc giả";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Xóa độc giả</h1>
            <p class="text-muted mb-0">Xác nhận xóa độc giả khỏi thư viện</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Xác nhận xóa độc giả
                    </h3>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning d-flex align-items-start" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            <strong>Cảnh báo!</strong>
                            <p class="mb-0 mt-1">
                                Bạn có chắc chắn muốn xóa độc giả này không?
                                Hãy kiểm tra thông tin trước khi thực hiện.
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Mã độc giả
                        </div>
                        <div class="col-md-8">
                            <span class="badge text-bg-secondary">
                                @Model.MemberCode
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Họ tên
                        </div>
                        <div class="col-md-8">
                            @Model.FullName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Email
                        </div>
                        <div class="col-md-8">
                            @Model.Email
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Số điện thoại
                        </div>
                        <div class="col-md-8">
                            @Model.Phone
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Địa chỉ
                        </div>
                        <div class="col-md-8">
                            @Model.Address
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Ngày gia nhập
                        </div>
                        <div class="col-md-8">
                            @Model.JoinDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Ngày hết hạn
                        </div>
                        <div class="col-md-8">
                            @Model.ExpiryDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">
                            Tình trạng
                        </div>
                        <div class="col-md-8">
                            @switch (Model.Status)
                            {
                                case Library.Models.MemberStatus.ACTIVE:
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Đang hoạt động
                                    </span>
                                    break;

                                case Library.Models.MemberStatus.EXPIRED:
                                    <span class="badge text-bg-warning">
                                        <i class="bi bi-clock me-1"></i>
                                        Hết hạn
                                    </span>
                                    break;

                                case Library.Models.MemberStatus.SUSPENDED:
                                    <span class="badge text-bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Tạm khóa
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 fw-bold">
                            Sách đánh mất
                        </div>
                        <div class="col-md-8">
                            <span class="badge @(Model.LostBookCount > 0 ? "text-bg-danger" : "text-bg-success")">
                                @Model.LostBookCount sách
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa độc giả @Model.FullName không?');">
                            <i class="bi bi-trash me-1"></i>
                            Xác nhận xóa
                        </button>

                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle me-1"></i>
                            Hủy
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-person-circle me-2"></i>
                        Thông tin độc giả
                    </h3>
                </div>

                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-circle fs-1 text-secondary"></i>
                    </div>

                    <h4 class="mb-1">@Model.FullName</h4>

                    <p class="text-muted mb-3">
                        @Model.MemberCode
                    </p>

                    @if (Model.Status == Library.Models.MemberStatus.ACTIVE)
                    {
                        <span class="badge text-bg-success">
                            Đang hoạt động
                        </span>
                    }
                    else if (Model.Status == Library.Models.MemberStatus.EXPIRED)
                    {
                        <span class="badge text-bg-warning">
                            Hết hạn
                        </span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">
                            Tạm khóa
                        </span>
                    }
                </div>
            </div>

            <div class="card border-warning">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Lưu ý
                    </h3>
                </div>

                <div class="card-body">
                    <p class="mb-2">
                        <i class="bi bi-check2 me-1"></i>
                        Kiểm tra thông tin độc giả trước khi xóa.
                    </p>

                    <p class="mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Các thông tin liên quan đến lịch sử mượn sách cần được xử lý phù hợp.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>