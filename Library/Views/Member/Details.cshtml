@model Library.Models.Member
@{
    ViewData["Title"] = "Chi tiết độc giả";
}
<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Chi tiết độc giả</h1>
            <p class="text-muted mb-0">
                Thông tin chi tiết của độc giả
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>
    <div class="row">
        <!-- Thông tin cá nhân -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-person me-2"></i>
                        Thông tin độc giả
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Mã độc giả -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-credit-card me-2"></i>
                            Mã độc giả
                        </div>
                        <div class="col-md-8">
                            <span class="badge text-bg-primary">
                                @Model.MemberCode
                            </span>
                        </div>
                    </div>
                    <hr />
                    <!-- Họ tên -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-person me-2"></i>
                            Họ tên
                        </div>
                        <div class="col-md-8">
                            @Model.FullName
                        </div>
                    </div>
                    <hr />
                    <!-- Email -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-envelope me-2"></i>
                            Email
                        </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                @Model.Email
                            }
                            else
                            {
                                <span class="text-muted">
                                    Chưa cập nhật
                                </span>
                            }
                        </div>
                    </div>
                    <hr />
                    <!-- Số điện thoại -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-telephone me-2"></i>
                            Số điện thoại
                        </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                @Model.Phone
                            }
                            else
                            {
                                <span class="text-muted">
                                    Chưa cập nhật
                                </span>
                            }
                        </div>
                    </div>
                    <hr />
                    <!-- Địa chỉ -->
                    <div class="row">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-geo-alt me-2"></i>
                            Địa chỉ
                        </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrWhiteSpace(Model.Address))
                            {
                                @Model.Address
                            }
                            else
                            {
                                <span class="text-muted">
                                    Chưa cập nhật
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- Thông tin thẻ -->
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-calendar-check me-2"></i>
                        Thông tin thẻ độc giả
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Ngày gia nhập -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-calendar-plus me-2"></i>
                            Ngày gia nhập
                        </div>
                        <div class="col-md-8">
                            @Model.JoinDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <hr />
                    <!-- Ngày hết hạn -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-calendar-x me-2"></i>
                            Ngày hết hạn
                        </div>
                        <div class="col-md-8">
                            @Model.ExpiryDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <hr />
                    <!-- Trạng thái -->
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-check-circle me-2"></i>
                            Tình trạng
                        </div>
                        <div class="col-md-8">
                            @switch (Model.Status)
                            {
                                case Library.Models.MemberStatus.ACTIVE:
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Đang hoạt động
                                    </span>
                                    break;
                                case Library.Models.MemberStatus.EXPIRED:
                                    <span class="badge text-bg-warning">
                                        <i class="bi bi-clock me-1"></i>
                                        Hết hạn
                                    </span>
                                    break;
                                case Library.Models.MemberStatus.SUSPENDED:
                                    <span class="badge text-bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Tạm khóa
                                    </span>
                                    break;
                            }
                        </div>
                    </div>
                    <hr />
                    <!-- Sách đánh mất -->
                    <div class="row">
                        <div class="col-md-4 fw-semibold">
                            <i class="bi bi-book me-2"></i>
                            Sách đánh mất
                        </div>
                        <div class="col-md-8">
                            @if (Model.LostBookCount > 0)
                            {
                                <span class="badge text-bg-danger">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    @Model.LostBookCount sách
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">
                                    0 sách
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Thông tin hệ thống -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Thông tin hệ thống
                    </h3>
                </div>
                <div class="card-body">
                    <!-- CreatedAt -->
                    <div class="mb-4">
                        <div class="text-muted small mb-1">
                            Ngày tạo
                        </div>
                        <div>
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <!-- UpdatedAt -->
                    <div class="mb-4">
                        <div class="text-muted small mb-1">
                            Cập nhật lần cuối
                        </div>
                        <div>
                            @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <!-- DeletedAt -->
                    <div>
                        <div class="text-muted small mb-1">
                            Ngày xóa
                        </div>
                        <div>
                            @if (Model.DeletedAt.HasValue)
                            {
                                @Model.DeletedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Chưa xóa
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- Thao tác -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-gear me-2"></i>
                        Thao tác
                    </h3>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            <i class="bi bi-pencil me-2"></i>
                            Chỉnh sửa độc giả
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>
                            Xóa độc giả
                        </a>
                        <a asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>