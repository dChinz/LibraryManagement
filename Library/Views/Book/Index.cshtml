@model IEnumerable<Library.Models.Book>
@{
    ViewData["Title"] = "Quản lý sách";
}
<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Quản lý sách</h1>
            <p class="text-muted mb-0">Quản lý sách trong thư viện</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Thêm sách
            </a>
        </div>
    </div>
    <!-- Card -->
    <div class="card shadow-sm">
        <!-- Card Header -->
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="bi bi-book me-2"></i>
                    Danh sách sách
                </h3>
                <span class="badge text-bg-primary">
                    @Model.Count() sách
                </span>
            </div>
        </div>
        <!-- Search -->
        <div class="card-body border-bottom">
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="searchBook"
                               class="form-control"
                               placeholder="Tìm kiếm theo tên sách, tác giả, ISBN..." />
                    </div>
                </div>
            </div>
        </div>
        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0"
                   id="bookTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th style="min-width: 220px;">
                            @Html.DisplayNameFor(model => model.Title)
                        </th>
                        <th style="width: 200px;">
                            @Html.DisplayNameFor(model => model.Author)
                        </th>
                        <th style="min-width: 160px;">
                            @Html.DisplayNameFor(model => model.Publisher)
                        </th>
                        <th style="width: 140px;">
                            @Html.DisplayNameFor(model => model.CategoryId)
                        </th>
                        <th style="width: 170px;">
                            @Html.DisplayNameFor(model => model.Isbn)
                        </th>
                        <th style="width: 130px;">
                            Số lượng
                        </th>
                        <th style="width: 110px;">
                            Ảnh bìa
                        </th>
                        <th style="width: 140px;">
                            Trạng thái
                        </th>
                        <th style="width: 130px;">
                            Thao tác
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- ID -->
                                <td class="fw-semibold">
                                    @item.Id
                                </td>
                                <!-- Tên sách -->
                                <td>
                                    <div class="fw-semibold">
                                        @item.Title
                                    </div>
                                </td>
                                <!-- Tác giả -->
                                <td>
                                    <span class="author-column"
                                          title="@item.Author">
                                        @item.Author
                                    </span>
                                </td>
                                <!-- Nhà xuất bản -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Publisher))
                                    {
                                        @item.Publisher
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </td>
                                <!-- Thể loại -->
                                <td>
                                    @if (item.Category != null)
                                    {
                                        <span class="badge text-bg-secondary">
                                            @item.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa xác định
                                        </span>
                                    }
                                </td>
                                <!-- ISBN -->
                                <td>
                                    <span class="font-monospace">
                                        @item.Isbn
                                    </span>
                                </td>
                                <!-- Số lượng -->
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="badge text-bg-primary">
                                            Tổng: @item.TotalCopies
                                        </span>
                                        <span class="badge text-bg-success">
                                            Có sẵn: @item.AvailableCopies
                                        </span>
                                    </div>
                                </td>
                                <!-- Ảnh bìa -->
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(item.CoverImagePath))
                                    {
                                        <img src="@item.CoverImagePath"
                                             alt="@item.Title"
                                             class="book-cover"
                                             title="@item.Title" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image text-muted fs-4"
                                           title="Chưa có ảnh bìa"></i>
                                    }
                                </td>
                                <!-- Trạng thái -->
                                <td>
                                    @if (item.DeletedAt == default(DateTime) || item.DeletedAt == null)
                                    {
                                        <span class="badge text-bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Đã xóa
                                        </span>
                                    }
                                </td>
                                <!-- Thao tác -->
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-danger"
                                           title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-book fs-1"></i>
                                    <p class="mt-3 mb-0">
                                        Chưa có sách nào
                                    </p>
                                    <a asp-action="Create"
                                       class="btn btn-primary btn-sm mt-3">
                                        <i class="bi bi-plus-lg me-1"></i>
                                        Thêm sách đầu tiên
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Footer -->
        <div class="card-footer text-muted">
            Tổng số:
            <strong>@Model.Count()</strong>
            sách
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.getElementById("searchBook").addEventListener("keyup", function () {
            const keyword = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll("#bookTable tbody tr");
            rows.forEach(function (row) {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    </script>
}