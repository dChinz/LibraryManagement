@model IEnumerable<Library.Models.Fine>

@{
    ViewData["Title"] = "Quản lý tiền phạt";
}

<div class="container-fluid">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Quản lý tiền phạt</h1>
            <p class="text-muted mb-0">
                Quản lý các khoản phạt của độc giả
            </p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Thêm khoản phạt
            </a>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="fineSearch"
                               class="form-control"
                               placeholder="Tìm kiếm theo độc giả, mã lượt mượn hoặc lý do..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <select id="paymentFilter"
                            class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Đã thanh toán">Đã thanh toán</option>
                        <option value="Chưa thanh toán">Chưa thanh toán</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="bi bi-cash-coin me-2"></i>
                Danh sách khoản phạt
            </h3>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0"
                       id="fineTable">

                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">#</th>

                            <th>
                                Độc giả
                            </th>

                            <th>
                                Lượt mượn
                            </th>

                            <th>
                                Số tiền
                            </th>

                            <th>
                                Lý do
                            </th>

                            <th>
                                Trạng thái
                            </th>

                            <th>
                                Ngày thanh toán
                            </th>

                            <th style="width: 160px;">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var item in Model)
                        {
                            var paymentStatus = item.IsPaid
                                ? "Đã thanh toán"
                                : "Chưa thanh toán";

                            <tr>
                                <td>
                                    <span class="text-muted">
                                        @index
                                    </span>
                                </td>

                                <!-- MEMBER -->
                                <td>
                                    @if (item.BorrowRecord?.Member != null)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <div class="fw-semibold">
                                                    @item.BorrowRecord.Member.FullName
                                                </div>

                                                <div class="text-muted small">
                                                    @item.BorrowRecord.Member.MemberCode
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Không có thông tin
                                        </span>
                                    }
                                </td>

                                <!-- BORROW RECORD -->
                                <td>
                                    <span class="badge text-bg-secondary">
                                        #@item.BorrowRecordId
                                    </span>
                                </td>

                                <!-- AMOUNT -->
                                <td>
                                    <span class="fw-semibold text-danger">
                                        @item.Amount.ToString("N0") ₫
                                    </span>
                                </td>

                                <!-- REASON -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Reason))
                                    {
                                        <span class="reason-column"
                                              title="@item.Reason">
                                            @item.Reason
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Không có lý do
                                        </span>
                                    }
                                </td>

                                <!-- PAYMENT STATUS -->
                                <td class="payment-status">
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge text-bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">
                                            <i class="bi bi-clock me-1"></i>
                                            Chưa thanh toán
                                        </span>
                                    }
                                </td>

                                <!-- PAID DATE -->
                                <td>
                                    @if (item.PaidDate.HasValue)
                                    {
                                        <span>
                                            @item.PaidDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa thanh toán
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Xem">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <!-- Edit -->
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!-- Delete -->
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-cash-coin fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Chưa có khoản phạt nào
                </h5>

                <p class="text-muted mb-3">
                    Hiện tại chưa có dữ liệu tiền phạt trong hệ thống.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Thêm khoản phạt
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("fineSearch");
            const paymentFilter = document.getElementById("paymentFilter");
            const table = document.getElementById("fineTable");

            if (!table) {
                return;
            }

            const rows = table.querySelectorAll("tbody tr");

            function filterTable() {
                const keyword = searchInput.value.toLowerCase().trim();
                const payment = paymentFilter.value.toLowerCase();

                rows.forEach(function (row) {
                    const text = row.textContent.toLowerCase();

                    const matchesSearch =
                        text.includes(keyword);

                    const matchesPayment =
                        payment === "" ||
                        text.includes(payment);

                    row.style.display =
                        matchesSearch && matchesPayment
                            ? ""
                            : "none";
                });
            }

            searchInput.addEventListener("input", filterTable);

            paymentFilter.addEventListener("change", filterTable);
        });
    </script>
}