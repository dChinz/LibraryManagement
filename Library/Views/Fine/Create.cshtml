@model Library.Models.Fine

@{
    ViewData["Title"] = "Thêm khoản phạt";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Thêm khoản phạt</h1>
            <p class="text-muted mb-0">
                Thêm khoản phạt mới cho lượt mượn sách
            </p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>

    <div class="row">

        <!-- Form chính -->
        <div class="col-lg-8">

            <div class="card mb-4">

                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-cash-coin me-2"></i>
                        Thông tin khoản phạt
                    </h3>
                </div>

                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert">
                        </div>

                        <!-- Lượt mượn -->
                        <div class="mb-4">

                            <label asp-for="BorrowRecordId" class="form-label">
                                Lượt mượn <span class="text-danger">*</span>
                            </label>

                            <select asp-for="BorrowRecordId"
                                    class="form-select"
                                    asp-items="ViewBag.BorrowRecordId">
                                <option value="">
                                    -- Chọn lượt mượn --
                                </option>
                            </select>

                            <span asp-validation-for="BorrowRecordId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Chọn lượt mượn phát sinh khoản phạt.
                            </div>

                        </div>

                        <!-- Số tiền -->
                        <div class="mb-4">

                            <label asp-for="Amount" class="form-label">
                                Số tiền phạt <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">

                                <input asp-for="Amount"
                                       type="number"
                                       class="form-control"
                                       min="0"
                                       step="1000"
                                       placeholder="Ví dụ: 50000" />

                                <span class="input-group-text">
                                    ₫
                                </span>

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Nhập số tiền phạt bằng VNĐ.
                            </div>

                        </div>

                        <!-- Lý do -->
                        <div class="mb-4">

                            <label asp-for="Reason" class="form-label">
                                Lý do phạt
                            </label>

                            <textarea asp-for="Reason"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ví dụ: Trả sách quá hạn, làm hư hỏng sách...">
                            </textarea>

                            <span asp-validation-for="Reason"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Thanh toán -->
                        <div class="mb-4">

                            <label class="form-label">
                                Trạng thái thanh toán
                            </label>

                            <div class="form-check form-switch">

                                <input asp-for="IsPaid"
                                       class="form-check-input"
                                       role="switch"
                                       id="isPaid" />

                                <label class="form-check-label"
                                       for="isPaid">
                                    Đã thanh toán
                                </label>

                            </div>

                            <span asp-validation-for="IsPaid"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Ngày thanh toán -->
                        <div class="mb-4"
                             id="paidDateContainer">

                            <label asp-for="PaidDate" class="form-label">
                                Ngày thanh toán
                            </label>

                            <input asp-for="PaidDate"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="PaidDate"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Có thể để trống nếu khoản phạt chưa được thanh toán.
                            </div>

                        </div>

                    </div>

                    <div class="card-footer">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            Thêm khoản phạt
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle me-1"></i>
                            Hủy
                        </a>

                    </div>

                </form>

            </div>

        </div>

        <!-- Thông tin hướng dẫn -->
        <div class="col-lg-4">

            <div class="card mb-4">

                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Lưu ý
                    </h3>
                </div>

                <div class="card-body">

                    <div class="d-flex mb-4">

                        <div class="me-3">
                            <i class="bi bi-book text-primary fs-4"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Lượt mượn
                            </div>

                            <div class="text-muted small">
                                Chọn lượt mượn liên quan đến khoản phạt.
                            </div>
                        </div>

                    </div>

                    <div class="d-flex mb-4">

                        <div class="me-3">
                            <i class="bi bi-cash text-danger fs-4"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Số tiền
                            </div>

                            <div class="text-muted small">
                                Nhập chính xác số tiền phạt bằng VNĐ.
                            </div>
                        </div>

                    </div>

                    <div class="d-flex">

                        <div class="me-3">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Thanh toán
                            </div>

                            <div class="text-muted small">
                                Nếu đã thanh toán, bật trạng thái và nhập ngày thanh toán.
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Thông tin hệ thống -->
            <div class="card">

                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-gear me-2"></i>
                        Thông tin hệ thống
                    </h3>
                </div>

                <div class="card-body">

                    <div class="text-muted small mb-2">
                        Ngày tạo và ngày cập nhật
                    </div>

                    <div class="text-muted">
                        <i class="bi bi-clock me-1"></i>
                        Hệ thống sẽ tự động thiết lập thời gian.
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const isPaid = document.getElementById("isPaid");
            const paidDateContainer = document.getElementById("paidDateContainer");
            const paidDate = document.getElementById("PaidDate");

            function updatePaidDate() {

                if (isPaid.checked) {
                    paidDateContainer.style.display = "";
                }
                else {
                    paidDateContainer.style.display = "none";
                    paidDate.value = "";
                }
            }

            updatePaidDate();

            isPaid.addEventListener("change", updatePaidDate);

        });
    </script>
}