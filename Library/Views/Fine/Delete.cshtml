@model Library.Models.Fine

@{
    ViewData["Title"] = "Xóa khoản phạt";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Xóa khoản phạt</h1>
            <p class="text-muted mb-0">
                Xác nhận xóa khoản phạt khỏi hệ thống
            </p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>

    <div class="row">

        <!-- Nội dung xác nhận -->
        <div class="col-lg-8">

            <div class="card border-danger">

                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2 text-danger"></i>
                        Xác nhận xóa
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-danger d-flex align-items-start"
                         role="alert">

                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                        <div>
                            <h5 class="alert-heading">
                                Bạn có chắc chắn muốn xóa khoản phạt này?
                            </h5>

                            <p class="mb-0">
                                Sau khi xóa, thông tin khoản phạt sẽ không còn
                                trong danh sách quản lý.
                            </p>
                        </div>

                    </div>

                    <!-- Thông tin khoản phạt -->
                    <div class="card border-0 mb-4">

                        <div class="card-body">

                            <div class="row mb-4">

                                <div class="col-md-4">
                                    <div class="text-muted small mb-1">
                                        Mã khoản phạt
                                    </div>

                                    <span class="badge text-bg-secondary fs-6">
                                        #@Model.Id
                                    </span>
                                </div>

                                <div class="col-md-8">
                                    <div class="text-muted small mb-1">
                                        Số tiền phạt
                                    </div>

                                    <div class="fw-bold fs-4 text-danger">
                                        @Model.Amount.ToString("N0") ₫
                                    </div>
                                </div>

                            </div>

                            <hr />

                            <div class="mb-4">

                                <div class="text-muted small mb-1">
                                    Lý do phạt
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Reason))
                                {
                                    <span class="text-muted">
                                        Không có lý do
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @Model.Reason
                                    </span>
                                }

                            </div>

                            <div class="row">

                                <div class="col-md-6">

                                    <div class="text-muted small mb-1">
                                        Trạng thái thanh toán
                                    </div>

                                    @if (Model.IsPaid)
                                    {
                                        <span class="badge text-bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">
                                            <i class="bi bi-clock me-1"></i>
                                            Chưa thanh toán
                                        </span>
                                    }

                                </div>

                                <div class="col-md-6">

                                    <div class="text-muted small mb-1">
                                        Ngày thanh toán
                                    </div>

                                    @if (Model.PaidDate.HasValue)
                                    {
                                        <span>
                                            @Model.PaidDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa thanh toán
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Thông tin lượt mượn -->
                    <h5 class="mb-3">
                        <i class="bi bi-book me-2"></i>
                        Thông tin lượt mượn
                    </h5>

                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <div class="text-muted small mb-1">
                                Mã lượt mượn
                            </div>

                            <span class="badge text-bg-secondary">
                                #@Model.BorrowRecordId
                            </span>
                        </div>

                        <div class="col-md-8 mb-3">

                            <div class="text-muted small mb-1">
                                Độc giả
                            </div>

                            @if (Model.BorrowRecord?.Member != null)
                            {
                                <div class="fw-semibold">
                                    @Model.BorrowRecord.Member.FullName
                                </div>

                                <div class="text-muted small">
                                    Mã độc giả:
                                    @Model.BorrowRecord.Member.MemberCode
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không có thông tin độc giả
                                </span>
                            }

                        </div>

                        <div class="col-md-12">

                            <div class="text-muted small mb-1">
                                Sách
                            </div>

                            @if (Model.BorrowRecord?.Book != null)
                            {
                                <div class="fw-semibold">
                                    @Model.BorrowRecord.Book.Title
                                </div>

                                <div class="text-muted small">
                                    ISBN: @Model.BorrowRecord.Book.Isbn
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không có thông tin sách
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="card-footer">

                    <form asp-action="Delete"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa khoản phạt này không?');">
                            <i class="bi bi-trash me-1"></i>
                            Xác nhận xóa
                        </button>

                    </form>

                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">
                        <i class="bi bi-x-circle me-1"></i>
                        Hủy
                    </a>

                </div>

            </div>

        </div>

        <!-- Cảnh báo -->
        <div class="col-lg-4">

            <div class="card border-warning mb-4">

                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        Lưu ý
                    </h3>
                </div>

                <div class="card-body">

                    <p class="mb-3">
                        Việc xóa khoản phạt sẽ loại bỏ dữ liệu này khỏi
                        hệ thống quản lý.
                    </p>

                    <div class="d-flex align-items-start">

                        <i class="bi bi-exclamation-circle text-warning fs-4 me-3"></i>

                        <div class="small text-muted">
                            Hãy kiểm tra kỹ thông tin khoản phạt trước khi
                            xác nhận xóa.
                        </div>

                    </div>

                </div>

            </div>

            <!-- Thông tin hệ thống -->
            <div class="card">

                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        Thông tin hệ thống
                    </h3>
                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <div class="text-muted small mb-1">
                            Ngày tạo
                        </div>

                        <div class="fw-semibold">
                            <i class="bi bi-calendar-plus me-1"></i>
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>

                    </div>

                    <div>

                        <div class="text-muted small mb-1">
                            Cập nhật lần cuối
                        </div>

                        <div class="fw-semibold">
                            <i class="bi bi-calendar-check me-1"></i>
                            @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>