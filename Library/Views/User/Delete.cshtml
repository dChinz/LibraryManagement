@model Library.Models.User

@{
    ViewData["Title"] = "Xóa người dùng";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                <i class="bi bi-person-x me-2"></i>
                Xóa người dùng
            </h1>
            <p class="text-muted mb-0">
                Xác nhận xóa tài khoản khỏi hệ thống
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">

                <!-- Warning -->
                <div class="card-header  border-bottom py-3">
                    <div class="d-flex align-items-center">

                        <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 52px; height: 52px;">
                            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                        </div>

                        <div>
                            <h5 class="mb-1 fw-semibold text-danger">
                                Xác nhận xóa người dùng
                            </h5>

                            <small class="text-muted">
                                Bạn có chắc chắn muốn xóa tài khoản này không?
                            </small>
                        </div>

                    </div>
                </div>

                <div class="card-body p-4">

                    <!-- User Information -->
                    <div class=" rounded-3 p-4 mb-4">

                        <div class="d-flex align-items-center mb-4">

                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 52px; height: 52px;">
                                <i class="bi bi-person text-primary fs-4"></i>
                            </div>

                            <div>
                                <h5 class="mb-1 fw-semibold">
                                    @Model.Username
                                </h5>

                                <small class="text-muted">
                                    Tài khoản hệ thống
                                </small>
                            </div>

                        </div>

                        <div class="row g-4">

                            <!-- Username -->
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">
                                    <i class="bi bi-person me-1"></i>
                                    Tên đăng nhập
                                </div>

                                <div class="fw-semibold">
                                    @Model.Username
                                </div>
                            </div>

                            <!-- Full Name -->
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">
                                    <i class="bi bi-person-vcard me-1"></i>
                                    Họ và tên
                                </div>

                                <div class="fw-semibold">
                                    @if (!string.IsNullOrWhiteSpace(Model.FullName))
                                    {
                                        @Model.FullName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">
                                    <i class="bi bi-envelope me-1"></i>
                                    Email
                                </div>

                                <div>
                                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                                    {
                                        @Model.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa cập nhật
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Role -->
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Quyền truy cập
                                </div>

                                <div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        <i class="bi bi-shield-check me-1"></i>
                                        @Model.Role
                                    </span>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">
                                    <i class="bi bi-toggle-on me-1"></i>
                                    Trạng thái
                                </div>

                                <div>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Đã khóa
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Created At -->
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">
                                    <i class="bi bi-calendar-plus me-1"></i>
                                    Ngày tạo
                                </div>

                                <div class="fw-semibold">
                                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- Warning Message -->
                    <div class="alert alert-warning d-flex align-items-start mb-4"
                         role="alert">

                        <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>

                        <div>
                            <strong>Lưu ý:</strong>
                            Hành động này sẽ xóa tài khoản
                            <strong>@Model.Username</strong>
                            khỏi hệ thống.
                        </div>

                    </div>

                    <!-- Actions -->
                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border">
                                <i class="bi bi-x-lg me-1"></i>
                                Hủy
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>
                                Xác nhận xóa
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>