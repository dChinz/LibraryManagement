@model IEnumerable<Library.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                <i class="bi bi-people me-2"></i>
                Quản lý người dùng
            </h1>
            <p class="text-muted mb-0">
                Quản lý tài khoản và quyền truy cập hệ thống
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Thêm người dùng
        </a>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-people text-primary fs-3"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Tổng người dùng
                        </div>
                        <div class="fs-4 fw-bold">
                            @Model.Count()
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-person-check text-success fs-3"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Đang hoạt động
                        </div>
                        <div class="fs-4 fw-bold">
                            @Model.Count(x => x.IsActive)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-secondary bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-person-x text-secondary fs-3"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Đã khóa
                        </div>
                        <div class="fs-4 fw-bold">
                            @Model.Count(x => !x.IsActive)
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- User Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header  border-bottom py-3">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1 fw-semibold">
                        <i class="bi bi-person-lines-fill me-2"></i>
                        Danh sách người dùng
                    </h5>

                    <small class="text-muted">
                        Danh sách tài khoản đang được quản lý trong hệ thống
                    </small>
                </div>

                <div class="text-muted small">
                    Tổng:
                    <strong>@Model.Count()</strong>
                    người dùng
                </div>

            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">#</th>

                            <th>
                                Tài khoản
                            </th>

                            <th>
                                Họ tên
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Quyền
                            </th>

                            <th class="text-center">
                                Trạng thái
                            </th>

                            <th class="text-center" style="width: 170px;">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            var stt = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-muted">
                                        @stt
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3"
                                                 style="width: 42px; height: 42px;">
                                                <i class="bi bi-person text-primary"></i>
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @item.Username
                                                </div>

                                                <small class="text-muted">
                                                    Tài khoản hệ thống
                                                </small>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.FullName))
                                        {
                                            <span>
                                                @item.FullName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa cập nhật
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <a href="mailto:@item.Email"
                                               class="text-decoration-none">
                                                <i class="bi bi-envelope me-1"></i>
                                                @item.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa cập nhật
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-shield-check me-1"></i>
                                            @item.Role
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Đã khóa
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">

                                    <div class="mb-3">
                                        <i class="bi bi-people text-muted"
                                           style="font-size: 48px;"></i>
                                    </div>

                                    <h5 class="text-muted">
                                        Chưa có người dùng
                                    </h5>

                                    <p class="text-muted mb-3">
                                        Hệ thống chưa có tài khoản người dùng nào.
                                    </p>

                                    <a asp-action="Create"
                                       class="btn btn-primary">
                                        <i class="bi bi-plus-lg me-1"></i>
                                        Thêm người dùng
                                    </a>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>