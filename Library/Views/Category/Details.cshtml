@model Library.Models.Category
@{
    ViewData["Title"] = "Chi tiết thể loại";
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Chi tiết thể loại</h1>
            <p class="text-muted mb-0">Xem thông tin chi tiết của thể loại sách</p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                <i class="bi bi-pencil-square"></i>
                Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="bi bi-info-circle me-2"></i>
                Thông tin thể loại
            </h3>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Mã thể loại</div>
                <div class="col-md-9">@Model.Id</div>
            </div>
            <hr />
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Tên thể loại</div>
                <div class="col-md-9">@Model.Name</div>
            </div>
            <hr />
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Mô tả</div>
                <div class="col-md-9">
                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <span class="text-muted">Chưa có mô tả</span>
                    }
                    else
                    {
                        @Model.Description
                    }
                </div>
            </div>
            <hr />
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Số lượng sách</div>
                <div class="col-md-9">
                    @(Model.Books?.Count ?? 0) sách
                </div>
            </div>
            <hr />
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Ngày tạo</div>
                <div class="col-md-9">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <hr />
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Ngày cập nhật</div>
                <div class="col-md-9">
                    @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-3 fw-bold">Trạng thái</div>
                <div class="col-md-9">
                    @if (Model.DeletedAt == default(DateTime))
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đã xóa</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>