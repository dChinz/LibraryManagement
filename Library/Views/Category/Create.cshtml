@model Library.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục";
}
<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Thêm danh mục</h1>
            <p class="text-muted mb-0">Thêm một danh mục sách mới vào thư viện</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 col-xl-7">
            <div class="card">
                <!-- Card Header -->
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-folder-plus me-2"></i>
                        Thông tin danh mục
                    </h3>
                </div>
                <!-- Form -->
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card-body">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <!-- Name -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label">
                                Tên danh mục
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Công nghệ thông tin" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="form-text">Nhập tên danh mục sách.</div>
                        </div>
                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả cho danh mục..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <div class="form-text">Mô tả ngắn gọn về danh mục sách.</div>
                        </div>
                    </div>
                    <!-- Card Footer -->
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i>
                            Lưu danh mục
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle me-1"></i>
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <!-- Information -->
        <div class="col-lg-4 col-xl-5">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-info-circle me-2"></i>
                        Thông tin
                    </h3>
                </div>
                <div class="card-body">
                    <p>
                        Danh mục giúp phân loại sách trong thư viện
                        và hỗ trợ người dùng tìm kiếm sách dễ dàng hơn.
                    </p>
                    <hr />
                    <div class="mb-3">
                        <strong>
                            <i class="bi bi-clock me-2"></i>
                            Ngày tạo
                        </strong>
                        <p class="text-muted mb-0">Hệ thống tự động ghi nhận.</p>
                    </div>
                    <div class="mb-3">
                        <strong>
                            <i class="bi bi-arrow-clockwise me-2"></i>
                            Ngày cập nhật
                        </strong>
                        <p class="text-muted mb-0">Hệ thống tự động cập nhật.</p>
                    </div>
                    <div>
                        <strong>
                            <i class="bi bi-book me-2"></i>
                            Sách
                        </strong>
                        <p class="text-muted mb-0">
                            Các sách thuộc danh mục này sẽ được hiển thị trong danh sách sách.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
