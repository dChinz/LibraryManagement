@model Library.Models.BorrowRecord

@{
    ViewData["Title"] = "Chi tiết lượt mượn";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Chi tiết lượt mượn</h1>
            <p class="text-muted mb-0">Xem thông tin chi tiết của lượt mượn sách</p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Chỉnh sửa
            </a>

            <a asp-action="Index"
               class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-journal-text me-2"></i>
                        Thông tin mượn sách
                    </h3>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Mã lượt mượn
                        </div>

                        <div class="col-md-8">
                            <span class="badge text-bg-secondary">
                                #@Model.Id
                            </span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Độc giả
                        </div>

                        <div class="col-md-8">
                            @if (Model.Member != null)
                            {
                                <div class="fw-semibold">
                                    @Model.Member.FullName
                                </div>

                                <div class="text-muted small">
                                    Mã độc giả: @Model.Member.MemberCode
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không tìm thấy thông tin độc giả
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Sách
                        </div>

                        <div class="col-md-8">
                            @if (Model.Book != null)
                            {
                                <div class="fw-semibold">
                                    @Model.Book.Title
                                </div>

                                <div class="text-muted small">
                                    ISBN: @Model.Book.Isbn
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không tìm thấy thông tin sách
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Ngày mượn
                        </div>

                        <div class="col-md-8">
                            @Model.BorrowDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Hạn trả
                        </div>

                        <div class="col-md-8">
                            @Model.DueDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Ngày trả
                        </div>

                        <div class="col-md-8">
                            @if (Model.ReturnDate.HasValue)
                            {
                                @Model.ReturnDate.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    Chưa trả
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Trạng thái
                        </div>

                        <div class="col-md-8">
                            @switch (Model.Status.ToString())
                            {
                                case "BORROWING":
                                    <span class="badge text-bg-primary">
                                        <i class="bi bi-book me-1"></i>
                                        Đang mượn
                                    </span>
                                    break;

                                case "RETURNED":
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Đã trả
                                    </span>
                                    break;

                                case "OVERDUE":
                                    <span class="badge text-bg-danger">
                                        <i class="bi bi-exclamation-circle me-1"></i>
                                        Quá hạn
                                    </span>
                                    break;

                                default:
                                    <span class="badge text-bg-secondary">
                                        @Model.Status
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 text-muted">
                            Ghi chú
                        </div>

                        <div class="col-md-8">
                            @if (!string.IsNullOrWhiteSpace(Model.Note))
                            {
                                <span>@Model.Note</span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không có ghi chú
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-person-vcard me-2"></i>
                        Độc giả
                    </h3>
                </div>

                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-circle fs-1 text-secondary"></i>
                    </div>

                    @if (Model.Member != null)
                    {
                        <h4 class="mb-1">
                            @Model.Member.FullName
                        </h4>

                        <p class="text-muted mb-3">
                            @Model.Member.MemberCode
                        </p>

                        <a asp-controller="Member"
                           asp-action="Details"
                           asp-route-id="@Model.MemberId"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-person me-1"></i>
                            Xem độc giả
                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Không có thông tin
                        </p>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-book me-2"></i>
                        Sách
                    </h3>
                </div>

                <div class="card-body">
                    @if (Model.Book != null)
                    {
                        <h5 class="mb-2">
                            @Model.Book.Title
                        </h5>

                        <div class="text-muted small mb-3">
                            ISBN: @Model.Book.Isbn
                        </div>

                        <a asp-controller="Book"
                           asp-action="Details"
                           asp-route-id="@Model.BookId"
                           class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-book me-1"></i>
                            Xem sách
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">
                            Không có thông tin sách
                        </span>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Thông tin hệ thống
                    </h3>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <div class="text-muted small mb-1">
                            Ngày tạo
                        </div>

                        <strong>
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>

                    <div>
                        <div class="text-muted small mb-1">
                            Cập nhật lần cuối
                        </div>

                        <strong>
                            @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>