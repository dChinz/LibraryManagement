@model Library.Models.BorrowRecord

@{
    ViewData["Title"] = "Thêm lượt mượn";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Thêm lượt mượn</h1>
            <p class="text-muted mb-0">Tạo một lượt mượn sách mới</p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-journal-plus me-2"></i>
                        Thông tin mượn sách
                    </h3>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="MemberId" class="form-label">
                                Độc giả <span class="text-danger">*</span>
                            </label>

                            <div class="input-group mb-2">
                                <span class="input-group-text">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input type="text"
                                       id="memberSearch"
                                       class="form-control"
                                       placeholder="Tìm kiếm theo mã hoặc tên độc giả..." />
                            </div>

                            <select asp-for="MemberId"
                                    id="memberSelect"
                                    class="form-select"
                                    asp-items="ViewBag.MemberId"
                                    size="5">
                            </select>

                            <span asp-validation-for="MemberId" class="text-danger"></span>

                            <div class="form-text">
                                Nhập tên hoặc mã độc giả để tìm kiếm, sau đó chọn độc giả trong danh sách.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Sách <span class="text-danger">*</span>
                            </label>

                            <div class="input-group mb-2">
                                <span class="input-group-text">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input type="text"
                                       id="bookSearch"
                                       class="form-control"
                                       placeholder="Tìm kiếm theo ISBN hoặc tên sách..." />
                            </div>

                            <select name="BookIds"
                                    id="bookSelect"
                                    class="form-select"
                                    multiple
                                    size="7">
                                @foreach (var book in ViewBag.Books)
                                {
                                    <option value="@book.Id">
                                        @book.DisplayName
                                    </option>
                                }
                            </select>

                            <span class="text-danger" id="bookError"></span>

                            <div class="form-text">
                                Có thể chọn nhiều sách. Giữ Ctrl để chọn nhiều sách.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DueDate" class="form-label">
                                Hạn trả <span class="text-danger">*</span>
                            </label>

                            <input asp-for="DueDate"
                                    type="date"
                                    class="form-control" />

                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ReturnDate" class="form-label">
                                Ngày trả
                            </label>

                            <input asp-for="ReturnDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="ReturnDate" class="text-danger"></span>

                            <div class="form-text">
                                Để trống nếu sách chưa được trả.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label">
                                Trạng thái <span class="text-danger">*</span>
                            </label>

                            <select asp-for="Status" class="form-select">
                                <option value="BORROWING">Đang mượn</option>
                                <option value="RETURNED">Đã trả</option>
                                <option value="OVERDUE">Quá hạn</option>
                            </select>

                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Note" class="form-label">
                                Ghi chú
                            </label>

                            <textarea asp-for="Note"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Nhập ghi chú nếu có..."></textarea>

                            <span asp-validation-for="Note" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            Lưu lượt mượn
                        </button>

                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle me-1"></i>
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Thông tin
                    </h3>
                </div>

                <div class="card-body">
                    <div class="mb-4">
                        <div class="text-muted small mb-1">
                            Ngày tạo
                        </div>

                        <span class="badge text-bg-success">
                            Tự động
                        </span>
                    </div>

                    <div class="mb-4">
                        <div class="text-muted small mb-1">
                            Ngày cập nhật
                        </div>

                        <span class="badge text-bg-primary">
                            Tự động
                        </span>
                    </div>

                    <div>
                        <div class="text-muted small mb-1">
                            Ngày trả
                        </div>

                        <span class="text-muted">
                            Để trống nếu chưa trả sách
                        </span>
                    </div>
                </div>
            </div>

            <div class="card border-warning">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Lưu ý
                    </h3>
                </div>

                <div class="card-body">
                    <p class="mb-2">
                        <i class="bi bi-check2 me-1"></i>
                        Kiểm tra độc giả và sách trước khi tạo lượt mượn.
                    </p>

                    <p class="mb-0">
                        <i class="bi bi-calendar-check me-1"></i>
                        Hạn trả phải sau ngày mượn.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("memberSearch").addEventListener("input", function () {
            const keyword = this.value.toLowerCase().trim();
            const select = document.getElementById("memberSelect");
            const options = select.querySelectorAll("option");

            options.forEach(function (option) {
                if (option.value === "") {
                    option.style.display = "";
                    return;
                }

                const text = option.textContent.toLowerCase();

                option.style.display = text.includes(keyword) ? "" : "none";
            });
        });

        document.getElementById("bookSearch").addEventListener("input", function () {
            const keyword = this.value.toLowerCase().trim();
            const select = document.getElementById("bookSelect");
            const options = select.querySelectorAll("option");

            options.forEach(function (option) {
                const text = option.textContent.toLowerCase();

                option.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    </script>
}