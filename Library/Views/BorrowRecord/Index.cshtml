@model IEnumerable<Library.Models.BorrowRecord>

@{
    ViewData["Title"] = "Quản lý mượn sách";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Quản lý mượn sách</h1>
            <p class="text-muted mb-0">Quản lý thông tin mượn và trả sách trong thư viện</p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Thêm lượt mượn
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="bi bi-journal-arrow-up me-2"></i>
                    Danh sách mượn sách
                </h3>

                <span class="badge text-bg-primary">
                    @Model.Count() lượt mượn
                </span>
            </div>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="searchBorrow"
                               class="form-control"
                               placeholder="Tìm kiếm lượt mượn..." />
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" id="borrowTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Độc giả</th>
                        <th>Sách</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Ngày trả</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.Id
                                </td>

                                <td>
                                    <span class="badge text-bg-secondary">
                                        <i class="bi bi-person me-1"></i>
                                        @item.Member?.FullName
                                    </span>
                                </td>

                                <td>
                                    <span class="badge text-bg-info">
                                        <i class="bi bi-book me-1"></i>
                                        @item.Book?.Title
                                    </span>
                                </td>

                                <td>
                                    @item.BorrowDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.DueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (item.ReturnDate.HasValue)
                                    {
                                        @item.ReturnDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa trả
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status.ToString() == "BORROWING")
                                    {
                                        <span class="badge text-bg-primary">
                                            <i class="bi bi-book me-1"></i>
                                            Đang mượn
                                        </span>
                                    }
                                    else if (item.Status.ToString() == "RETURNED")
                                    {
                                        <span class="badge text-bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Đã trả
                                        </span>
                                    }
                                    else if (item.Status.ToString() == "OVERDUE")
                                    {
                                        <span class="badge text-bg-danger">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Quá hạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td class="note-column" title="@item.Note">
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        @item.Note
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Không có
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info"
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-danger"
                                           title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-journal-x fs-1"></i>

                                    <p class="mt-3 mb-0">
                                        Chưa có lượt mượn nào
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer text-muted">
            Tổng số:
            <strong>@Model.Count()</strong>
            lượt mượn
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("searchBorrow").addEventListener("keyup", function () {
            const keyword = this.value.toLowerCase();
            const rows = document.querySelectorAll("#borrowTable tbody tr");

            rows.forEach(function (row) {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    </script>
}